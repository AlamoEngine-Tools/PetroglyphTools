<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:complexType name="TranslationType">
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="Language" type="xs:string" use="required" />
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>
    <xs:complexType name="TranslationDataType">
        <xs:sequence>
            <xs:element name="Translation" type="TranslationType" maxOccurs="unbounded" minOccurs="1" />
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="LocalisationType">
        <xs:sequence>
            <xs:element name="TranslationData" type="TranslationDataType" maxOccurs="1" minOccurs="1" />
        </xs:sequence>
        <xs:attribute name="Key" type="xs:string" use="required" />
    </xs:complexType>
    <xs:complexType name="LocalisationDataType">
        <xs:sequence>
            <xs:element name="Localisation" type="LocalisationType" maxOccurs="unbounded" minOccurs="1" />
        </xs:sequence>
    </xs:complexType>
    <xs:element name="LocalisationData" type="LocalisationDataType" />
</xs:schema>